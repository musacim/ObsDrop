+    dead = None if cur is None else cur.get("dead")
+    if dead is None or lens is None:
+        return _ds_compact_inplace(kv_indptr, kv_indices, bs), None
+    rb = min(len(dead), len(lens), bs)
+    if not any(dead[:rb]):
+        return False, None
+    real = [int(x) for x in lens[:rb]]
+    rest = int(n_total) - sum(real)
+    pad = bs - rb
+    pad_lens = []
