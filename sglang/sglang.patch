+def _rm_spans_slow(ids):
+    spans, i, n = [], 0, len(ids)
+    while i < n:
+        if ids[i] == _RM_OPEN:
+            j = i + 1
+            while j < n and ids[j] != _RM_CLOSE:
+                j += 1
+            if j >= n:
+                break
+            spans.append((i + 1, j))  # content only; markers stay
+            i = j
+        i += 1
+    return spans
