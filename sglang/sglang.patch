+    """Same spans as _rm_spans_slow, found with numpy (loops over observations, not tokens)."""
+    import numpy as _np
+    arr = _np.asarray(ids, dtype=_np.int64)
+    opens = _np.flatnonzero(arr == _RM_OPEN)
+    closes = _np.flatnonzero(arr == _RM_CLOSE)
+    spans, end = [], -1
+    for o in opens.tolist():
+        if o <= end:                       # inside the previous span: skipped, as in the token loop
+            continue
