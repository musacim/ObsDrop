+    seg = torch.repeat_interleave(torch.arange(bs, device=idx.device), lens)
+    kept = torch.zeros(bs, dtype=torch.int64, device=idx.device)
+    kept.scatter_add_(0, seg, keep.to(torch.int64))
+    keep = keep | (kept[seg] == 0)
+    new_lens = torch.zeros(bs, dtype=torch.int64, device=idx.device)
+    new_lens.scatter_add_(0, seg, keep.to(torch.int64))
+    comp = idx[keep]
