+_LOG_CONV = _os.environ.get("SGLANG_LOG_TTFT", "0") == "1"
+_CONV_SEEN = set()
+_DP_ASSIGN = {}  # agent key -> dp rank
+_DP_SEEN = {}  # agent key -> last request time
+
+
+def _dp_sticky_rank(messages, dp_size):
+    # agent key = first user message (the task text). A new agent goes to the rank with the fewest
+    # ACTIVE agents (seen in the last 300s), so one-off requests (e.g. a startup call with a different
+    # first message) do not count as load for long.
+    import time as _time
+
+    first = next((m for m in messages if m.role == "user"), None)
+    c = first.content if first is not None else ""
+    if not isinstance(c, str):
+        c = "".join(getattr(p, "text", "") or "" for p in c)
+    key = _hashlib.md5(c[:2000].encode("utf-8", "ignore")).hexdigest()   # task text only: stable when an LLM summary is appended later
+    now = _time.time()
+    r = _DP_ASSIGN.get(key)
+    if r is None:
+        load = [0] * dp_size
+        for k, v in _DP_ASSIGN.items():
+            if now - _DP_SEEN.get(k, 0) < 300:
+                load[v] += 1
+        r = min(range(dp_size), key=lambda i: load[i])
+        _DP_ASSIGN[key] = r
+        load[r] += 1
+        logger.info(f"[DPSTICKY] new agent {key[:8]} (msgs={len(messages)}) -> dp rank {r} (active agents per rank {load})")
+    _DP_SEEN[key] = now
+    return r
+
