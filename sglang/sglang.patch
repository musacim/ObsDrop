+def _text_obs_mask(messages, keep):
+    def _text(c):
+        if c is None:
+            return ""
+        if isinstance(c, str):
+            return c
+        return "".join(getattr(p, "text", "") or "" for p in c)
+
+    obs = [i for i, m in enumerate(messages) if m.role == "tool"]
+    old = obs[: max(0, (len(obs) // _TEXT_OBS_POLL) * _TEXT_OBS_POLL - keep)]
+    removed = 0
+    for i in old:
+        txt = _text(messages[i].content)
+        ph = f"Old environment output: ({len(txt.splitlines())} lines omitted)"
+        if txt != ph:
+            removed += len(txt) - len(ph)
+            messages[i].content = ph
