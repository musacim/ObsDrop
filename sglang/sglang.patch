+def _ds_compact_inplace(kv_indptr, kv_indices, bs):
+    """Drop slot-0 entries in place (works for CUDA-graph fixed buffers). Rows that would become empty
+    (graph padding rows) keep their entries. Returns True if anything changed."""
+    n = int(kv_indptr[bs])
+    if n == 0:
+        return False
+    idx = kv_indices[:n]
+    keep = idx != 0
+    if bool(keep.all()):
+        return False
